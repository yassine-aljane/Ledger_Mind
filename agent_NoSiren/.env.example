# === LLM Mistral (obtenir une clé sur https://console.mistral.ai) ===
MISTRAL_API_KEY=changeme
# Modèles Mistral disponibles (dont gratuits/économiques) :
#   open-mistral-nemo (gratuit/léger), mistral-small-latest, mistral-large-latest
MISTRAL_MODEL=mistral-small-latest

# === Embeddings ===
# "local"  -> sentence-transformers, 100% gratuit, tourne sur votre machine (par défaut)
# "mistral"-> API mistral-embed (payant)
EMBEDDINGS_PROVIDER=local
LOCAL_EMBEDDING_MODEL=intfloat/multilingual-e5-large

# === Base vectorielle (ChromaDB, embarquée, gratuite, aucun serveur à lancer) ===
CHROMA_DIR=./data/chroma
CHROMA_COLLECTION=corpus_fiscal_fr

# === Veille Légifrance via PISTE (inscription gratuite sur https://piste.gouv.fr) ===
# Laisser vide pour désactiver l'API et n'utiliser que le scraping.
PISTE_CLIENT_ID=
PISTE_CLIENT_SECRET=

# === Planification de la veille ===
VEILLE_ENABLED=true
VEILLE_CRON_HOUR=6          # exécution quotidienne à 6h
FRESHNESS_MAX_DAYS=120      # au-delà, on affiche un avertissement de fraîcheur

APP_ENV=dev
