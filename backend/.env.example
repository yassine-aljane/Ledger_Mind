# Gemini — agent intake UNIQUEMENT (branche SIREN : questions + compréhension des réponses)
# et OCR. Get a free key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Attention au palier gratuit : gemini-2.5-flash plafonne à 20 requêtes PAR JOUR, épuisées en
# quelques échanges. flash-lite offre un quota nettement plus large pour le même usage.
GEMINI_MODEL=gemini-2.5-flash-lite

# Mistral — espace guidance / assistant fiscal / veille (chat + embeddings du corpus), et OCR
# de capture documentaire. Quota SÉPARÉ de Gemini : l'épuisement d'un fournisseur n'éteint pas
# l'autre. Get a key at: https://console.mistral.ai
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=mistral-small-latest
# mistral-embed : 1024 dimensions. Après tout changement de EMBEDDING_MODEL, revectoriser le
# corpus existant (python -m backend.scripts.reembed_corpus) — des vecteurs de modèles différents
# ne sont pas comparables entre eux.
EMBEDDING_MODEL=mistral-embed

# MongoDB (users + orchestrator sessions + agent context)
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=ledgermind

# Auth JWT — change in production (min 32 characters)
AUTH_SECRET=ledgermind-dev-secret-change-me-32b
AUTH_TOKEN_DAYS=14

# CORS — set to your frontend URL
FRONTEND_ORIGIN=http://localhost:3000

# Veille réglementaire — tâche de fond, aucune interface utilisateur.
# Un cycle par jour (collecte MCP, ré-ingestion du corpus, contrôle des seuils). Rien ne se
# déclenche au démarrage et l'échec d'une source est seulement journalisé.
# Clés PISTE facultatives : sans elles, Légifrance est ignoré, les autres sources restent actives.
VEILLE_ENABLED=true
VEILLE_CRON_HOUR=6
PISTE_CLIENT_ID=
PISTE_CLIENT_SECRET=
