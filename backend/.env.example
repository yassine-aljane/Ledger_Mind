# Gemini (Intake agent — questions + answer understanding)
# Get a free key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# MongoDB (users + orchestrator sessions + agent context)
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=ledgermind

# Auth JWT — change in production (min 32 characters)
AUTH_SECRET=ledgermind-dev-secret-change-me-32b
AUTH_TOKEN_DAYS=14

# CORS — set to your frontend URL
FRONTEND_ORIGIN=http://localhost:3000
