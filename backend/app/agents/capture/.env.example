# Copiez ce fichier en .env puis renseignez les valeurs.

# Obligatoire : clé API Mistral (console.mistral.ai)
MISTRAL_API_KEY=

# MongoDB — deux possibilités :
#   Local  : mongodb://localhost:27017
#   Cloud  : MongoDB Atlas (gratuit M0), format SRV ci-dessous.
# Récupérez la chaîne dans Atlas > Connect > Drivers, remplacez <password>
# par votre mot de passe (encodez les caractères spéciaux, ex. @ -> %40),
# et ajoutez le nom de base après le "/" (ici : ledgermind).
MONGODB_URI=
# Optionnel : noms de base
MONGODB_DB=
CHECKPOINT_DB=
